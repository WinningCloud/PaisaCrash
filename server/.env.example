PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ElevenLabs voice agents (see server/agent/)
# In-game Paisa Pal (reacts to cards, decisions and years)
ELEVENLABS_AGENT_ID=
# General money coach on the title screen
ELEVENLABS_HOME_AGENT_ID=
